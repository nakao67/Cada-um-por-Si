// Firebase Realtime Database Rules — substitua SEU_EMAIL_GOOGLE_AQUI pelo e-mail administrador.
{
  "rules": {
    "posts": {
      ".read": true,
      "$postId": {
        ".write": "auth != null && auth.token.email === 'SEU_EMAIL_GOOGLE_AQUI'",
        ".validate": "newData.hasChildren(['title', 'body', 'createdAt'])"
      }
    }
  }
}
